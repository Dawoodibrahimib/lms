{
  "name": "inventory-system",
  "version": "1.0.0",
  "description": "JFS-Nethawk-LMS",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder --win dir",
    "preview": "vite build && electron ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.11.0",
    "synk": "^0.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.1",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.inventory.laptops",
    "productName": "JFS-Nethawk-LMS",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "seed.db",
        "to": "seed.db"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "laptop.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "laptop.ico",
      "uninstallerIcon": "laptop.ico",
      "installerHeaderIcon": "laptop.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JFS-Nethawk-LMS"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
